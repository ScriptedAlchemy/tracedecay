common --enable_bzlmod
common --announce_rc
common --show_progress_rate_limit=15
# build:linux, build:macos, and build:windows apply on their own hosts.
common --enable_platform_specific_config
build --incompatible_enable_cc_toolchain_resolution
build --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --workspace_status_command=scripts/bazel/workspace_status.sh
build:windows --workspace_status_command=scripts/bazel/workspace_status.bat
# .cargo/config.toml compiles vendored C deps with NDEBUG. Keep parity for
# cc crates built inside cargo_build_script actions (tree-sitter grammars).
build --action_env=CFLAGS=-DNDEBUG
build --action_env=CXXFLAGS=-DNDEBUG
# rules_rust compiles env!("CARGO_MANIFEST_DIR") to "${pwd}/<pkg>", which is the
# sandbox execroot. Crates that read CARGO_MANIFEST_DIR with env! instead of
# env::var (arborium grammars) then use a dead sandbox path when the build
# script runs. Compiling build-script binaries locally bakes the stable real
# execroot. Only the *_ / _bs_ script binaries match. Lib and bin compiles
# stay sandboxed.
build "--strategy_regexp=Compiling Rust bin _bs_.*=local"
build "--strategy_regexp=Compiling Rust bin build_script_build_.*=local"
# ld.bfd peaks near 4 GB per link. Cap parallelism so links do not
# OOM-kill each other on 8-core/32 GB workers.
build --jobs=4
build:linux "--@rules_rust//rust/settings:extra_rustc_flag=-Clink-arg=-fuse-ld=bfd"
# MSVC encodes narrow string literals in the host ANSI code page unless told
# otherwise, so tree-sitter grammars that spell symbol names as universal
# character names become invalid UTF-8 (see .cargo/config.toml).
build:windows "--action_env=CFLAGS=-DNDEBUG /utf-8"
build:windows "--action_env=CXXFLAGS=-DNDEBUG /utf-8"
# Windows runfiles default to a manifest; suites read fixtures and spawn
# binaries through the runfiles tree.
build:windows --enable_runfiles

test --test_output=errors

# Blocking Clippy policy over every Rust target, matching
# `cargo clippy --workspace --all-targets -- -D warnings`.
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=+clippy_checks
build:clippy --@rules_rust//rust/settings:clippy_flag=-Dwarnings

# The shipped binary: Cargo's release profile (opt-level 3, no debug
# assertions). Externals return to opt-level 3 over the perf overrides below.
build:release --compilation_mode=opt
build:release --@rules_rust//rust/settings:per_crate_rustc_flag=external/@-Copt-level=3

# Hosted CI: keep going past one failure so a run reports every red target.
build:ci --keep_going
build:ci --show_timestamps
test:ci --test_summary=terse
# Suites spawn host tools (ast-grep, node, git, and rust-analyzer through
# the rustup proxy, which needs its homes to find the pinned toolchain).
test:ci --test_env=PATH
test:ci --test_env=RUSTUP_HOME
test:ci --test_env=CARGO_HOME

# BEGIN generated by scripts/bazel/gen_builds.py
# Cargo perf opt-levels for external crates (see [profile.perf]).
build "--@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__grafeo-adapters-0.5.43/@-Copt-level=2"
build "--@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__grafeo-common-0.5.43/@-Copt-level=2"
build "--@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__grafeo-core-0.5.43/@-Copt-level=2"
build "--@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__grafeo-engine-0.5.43/@-Copt-level=2"
build "--@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__grafeo-storage-0.5.43/@-Copt-level=2"
build "--@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__regex-1.13.1/@-Copt-level=2"
build "--@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__serde_json-1.0.151/@-Copt-level=2"
build "--@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__sha2-0.11.0/@-Copt-level=3"
build "--@rules_rust//rust/settings:per_crate_rustc_flag=external/rules_rust++crate+crates__tiktoken-rs-0.12.1/@-Copt-level=2"
# END generated by scripts/bazel/gen_builds.py
