+// Temporary archival export hook; never merged into the current writer.
+#[test]
+fn export_historical_partitioned_writer_fixture() {
+    let (generation, manifest, segments) = partitioned_codec_fixture();
+    let identities = CodeIndexPublishedGenerationV1::partitioned_segment_identities(&manifest)
+        .expect("historical descriptors")
+        .expect("historical partitioned format");
+    let expected = generation
+        .encode_sealed()
+        .expect("historical canonical generation");
+    let out = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../../fixture-export");
+    std::fs::create_dir(&out).expect("create fresh fixture export directory");
+    std::fs::create_dir(out.join("segments")).expect("create segment directory");
+    std::fs::write(out.join("manifest.json"), &manifest).expect("export historical manifest");
+    std::fs::write(out.join("expected-generation.json"), &expected)
+        .expect("export historical canonical generation");
+    let segment_provenance = segments
+        .iter()
+        .map(|(digest, bytes)| {
+            let hex = digest
+                .strip_prefix("sha256:")
+                .expect("content addressed segment");
+            assert_eq!(
+                format!("sha256:{}", hex::encode(Sha256::digest(bytes))),
+                *digest
+            );
+            std::fs::write(out.join("segments").join(format!("{hex}.json")), bytes)
+                .expect("export actual historical segment bytes");
+            serde_json::json!({"digest": digest, "bytes": bytes.len()})
+        })
+        .collect::<Vec<_>>();
+    let provenance = serde_json::json!({
+        "writer_commit": "e95f373f883e9cb68e4f6d1cb786efc8a17bf5de",
+        "writer_path": "crates/tracedecay-code-index/src/production/partitioned_codec.rs",
+        "writer_sha256": hex::encode(Sha256::digest(include_bytes!("../../src/production/partitioned_codec.rs"))),
+        "export_test_sha256": hex::encode(Sha256::digest(include_bytes!("production_orchestration.rs"))),
+        "manifest_sha256": hex::encode(Sha256::digest(&manifest)),
+        "expected_generation_sha256": hex::encode(Sha256::digest(&expected)),
+        "generation_id": generation.manifest().generation_id.as_str(),
+        "snapshot_content_identity": generation.snapshot().content_identity.as_str(),
+        "referenced_segments": identities.iter().map(|identity| serde_json::json!({"digest": identity.digest.as_str(), "bytes": identity.size_bytes})).collect::<Vec<_>>(),
+        "emitted_segments": segment_provenance,
+    });
+    std::fs::write(
+        out.join("provenance.json"),
+        serde_json::to_vec_pretty(&provenance).unwrap(),
+    )
+    .expect("export fixture provenance");
+    println!("historical writer fixture exported to {}", out.display());
+}
