filegroup(
    name = "rustfmt_sources_2024",
    srcs = depset(["build.rs", "src/product_version/root_manifest.rs"] + glob(["src/**/*.rs"]) + glob(["tests/**/*.rs"], exclude = ["tests/fixtures/**"])).to_list(),
    tags = ["manual"],
)

genrule(
    name = "rustfmt_check_2024",
    srcs = [":rustfmt_sources_2024", "//:rustfmt.toml"],
    outs = ["rustfmt_check_2024.ok"],
    cmd = "\"$(RUSTFMT)\" --config-path \"$(location //:rustfmt.toml)\" --edition 2024 --config skip_children=true --check $(locations :rustfmt_sources_2024) && touch \"$@\"",
    cmd_ps = "$$env:PATHEXT += ';.EXE'; foreach ($$source in ('$(locations :rustfmt_sources_2024)' -split ' ')) { & \"$(RUSTFMT)\" --config-path \"$(location //:rustfmt.toml)\" --edition 2024 --config skip_children=true --check $$source; if ($$LASTEXITCODE -ne 0) { exit $$LASTEXITCODE } }; New-Item -ItemType File -Path \"$@\" -Force | Out-Null",
    tools = ["//:rustfmt_toolchain"],
    toolchains = ["//:rustfmt_toolchain"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "src_agents_hermes_templates",
    srcs = glob(["src/agents/hermes/templates/**"]),
    visibility = ["//visibility:public"],
)
