load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

exports_files(
    [
        "version.txt",
        "Cargo.toml",
        "pnpm-lock.yaml",
        "pnpm-lock.bazel.yaml",
    ],
    visibility = ["//visibility:public"],
)

genrule(
    name = "product_git_sha",
    srcs = [],
    outs = ["product_git_sha.txt"],
    cmd = "grep '^STABLE_PRODUCT_GIT_SHA ' bazel-out/stable-status.txt | cut -d' ' -f2 > $@",
    stamp = True,
    visibility = ["//visibility:public"],
)

# `-c opt` is the release build: generated Rust targets drop their Cargo
# `perf` opt-level and debug assertions under it (scripts/bazel/gen_builds.py).
config_setting(
    name = "opt_mode",
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)
