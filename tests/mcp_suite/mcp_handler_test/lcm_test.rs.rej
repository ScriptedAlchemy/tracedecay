-        21
-    );
-    assert_eq!(
-        db.lcm_raw_message_count_for_test(HostAdmissionScope::Project, "normal-session")
-            .await
-            .unwrap(),
-        1
-    );
-    assert!(!text.contains("Cronjob Response: noisy heartbeat"));
-    assert!(!text.contains("valuable payload to preserve"));
-}
