     let compress = tools
         .iter()
         .find(|tool| tool.name == "tracedecay_lcm_compress")
         .expect("tracedecay_lcm_compress definition");
-    let modes = compress.input_schema["properties"]["summarizer"]["properties"]["mode"]["enum"]
