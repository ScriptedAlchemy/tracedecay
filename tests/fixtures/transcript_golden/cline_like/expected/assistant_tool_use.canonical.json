{
  "description": "Canonical-envelope projection expectations after production Cline-family parsing of input/api_conversation_history.json (and Roo api_messages.json twin). Placeholders PROVIDER and SESSION_ID are substituted by the harness.",
  "must_run_provider_parser": true,
  "forbid_synthetic_canonical_bypass": true,
  "per_provider": {
    "cline": {
      "provider": "cline",
      "extension_id": "saoudrizwan.claude-dev",
      "api_history_filename": "api_conversation_history.json"
    },
    "roo-code": {
      "provider": "roo-code",
      "extension_id": "rooveterinaryinc.roo-cline",
      "api_history_filename": "api_messages.json"
    },
    "kilo": {
      "provider": "kilo",
      "extension_id": "kilocode.kilo-code",
      "api_history_filename": "api_conversation_history.json"
    }
  },
  "assistant_envelope": {
    "version": 1,
    "provider": "<PROVIDER>",
    "native_record_kind": "message",
    "relations": {
      "session_id": "<SESSION_ID>",
      "absent": [
        "thread_id",
        "turn_id",
        "agent_id",
        "parent_agent_id",
        "parent_message_id"
      ]
    },
    "evidence": {
      "ordering_domain": "snapshot_order",
      "native_timestamp": 1800000010,
      "native_sequence": 1
    },
    "facts": [
      {
        "kind": "message",
        "role": "assistant",
        "content": "The billing pipeline regression is fixed.",
        "model": "claude-sonnet-4.6"
      },
      {
        "kind": "tool_invocation",
        "name": "read_file",
        "arguments": null
      }
    ],
    "encoded_must_contain": [
      "read_file",
      "\"arguments\":null",
      "The billing pipeline regression is fixed."
    ],
    "encoded_must_not_contain": [
      "src/billing.rs",
      "hostile-thread",
      "tool_calls"
    ]
  },
  "parser_derived_native_payload": {
    "tool_names": "read_file",
    "absent": [
      "tool_calls",
      "tool_result",
      "reasoning",
      "git",
      "workflow"
    ]
  }
}
