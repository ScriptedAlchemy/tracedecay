from pathlib import Path
import re, subprocess
R=Path.cwd()

def read(p): return (R/p).read_text()
def write(p,s): (R/p).parent.mkdir(parents=True,exist_ok=True); (R/p).write_text(s)
def replace(s,a,b,count=1):
    n=s.count(a)
    assert n==count,(a[:100],n,count)
    return s.replace(a,b)

def end_brace(s,start):
    # Local editing utility: find the balanced body while skipping Rust literals/comments.
    p=s.index('{',start); depth=0; i=p
    while i<len(s):
        if s.startswith('//',i):
            e=s.find('\n',i); i=len(s) if e<0 else e; continue
        if s.startswith('/*',i):
            n=1;i+=2
            while n:
                if s.startswith('/*',i):n+=1;i+=2
                elif s.startswith('*/',i):n-=1;i+=2
                else:i+=1
            continue
        m=re.match(r'(?:br|cr|r)(#*)"',s[i:])
        if m:
            q='"'+m[1]; e=s.find(q,i+m.end());assert e>=0;i=e+len(q);continue
        if s[i]=='"':
            i+=1
            while s[i]!='"':
                i+=2 if s[i]=='\\' else 1
            i+=1;continue
        if s[i]=="'":
            m=re.match(r"'(?:\\(?:u\{[0-9a-fA-F]+\}|x[0-9a-fA-F]{2}|.)|[^'\\\n])'",s[i:])
            if m:i+=len(m[0]);continue
        if s[i]=='{':depth+=1
        if s[i]=='}':
            depth-=1
            if depth==0:return i+1
        i+=1
    raise ValueError('unbalanced')

def item_range(s, name, kind='fn', attrs=True):
    m=re.search(r'(?m)^\s*(?:pub(?:\([^\n]*?\))?\s+)?(?:async\s+)?'+kind+r'\s+'+re.escape(name)+r'\b',s)
    assert m,name
    start=s.rfind('\n',0,m.start()+len(m[0])-len(m[0].lstrip()))+1
    if attrs:
        prev=s.rfind('\n\n',0,start)
        proposed=prev+2 if prev>=0 else 0
        pre=s[proposed:start]
        # Attribute/docs before one item; never swallow a preceding use or body.
        if pre.lstrip().startswith(('#[','///','//')):
            start=proposed
    end=end_brace(s,m.end())
    return start,end

def remove_item(s,name,kind='fn'):
    a,b=item_range(s,name,kind);return s[:a]+s[b:].lstrip('\n')

def extract_item(s,name,kind='fn'):
    a,b=item_range(s,name,kind);return s[a:b]+'\n\n'

