#[test]
fn branch_selection_stays_explicit_after_automatic_pr_indexing_is_retired() {
    for action in ["enable", "disable", "status"] {
        let error = match Cli::try_parse_from(["tracedecay", "branch", "autotrack", action]) {
            Ok(_) => panic!("retired automatic indexing must not be accepted"),
            Err(error) => error,
        };
        assert_eq!(error.kind(), ErrorKind::InvalidSubcommand);
    }
    let cli = Cli::try_parse_from([
        "tracedecay", "branch", "add", "feature/requested", "--path", "/tmp/project",
    ]).expect("explicit branch activation remains supported");
    assert!(matches!(cli.command, Some(Commands::Branch {
        action: BranchAction::Add { name, path }
    }) if name.as_deref() == Some("feature/requested") && path.as_deref() == Some("/tmp/project")));
}
