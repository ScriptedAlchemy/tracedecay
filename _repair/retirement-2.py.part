fn retired_pr_inventory_reports_exact_records_without_touching_artifacts() {
    let root = tempfile::tempdir().expect("profile");
    assert_eq!(retired_pr_artifacts_warning(root.path()), None);
    let worktree = root.path().join("pr-worktrees/pr-7");
    std::fs::create_dir_all(&worktree).expect("worktree");
    let dirty = worktree.join("uncommitted.txt");
    std::fs::write(&dirty, "operator-owned edits").expect("dirty artifact");
    let inventory = serde_json::json!({"managed": {
        "tracedecay/autotrack/pr/7": {
            "pr": 7,
            "head_branch": "feature/example",
            "head_sha": "1111111111111111111111111111111111111111",
            "worktree": worktree,
            "tracking_ref": "refs/tracedecay/pr/7"
        }
    }});
    let bytes = serde_json::to_vec(&inventory).expect("inventory bytes");
    let path = root.path().join("pr-autotrack.json");
    std::fs::write(&path, &bytes).expect("inventory");
    let warning = retired_pr_artifacts_warning(root.path()).expect("report retained artifacts");
    for detail in ["tracedecay/autotrack/pr/7", "feature/example", "refs/tracedecay/pr/7", "1111111111111111111111111111111111111111", "not a current ownership proof"] {
        assert!(warning.contains(detail), "missing inventory detail: {detail}");
    }
    assert!(warning.contains(&format!("{worktree:?}")));
    assert_eq!(std::fs::read(&path).expect("retained inventory"), bytes);
    assert_eq!(std::fs::read_to_string(&dirty).expect("retained edits"), "operator-owned edits");
}

#[test]
fn retired_pr_inventory_never_guesses_ownership_from_invalid_state() {
    let root = tempfile::tempdir().expect("profile");
    let path = root.path().join("pr-autotrack.json");
    std::fs::write(&path, "{not json").expect("invalid inventory");
    let warning = retired_pr_artifacts_warning(root.path()).expect("report invalid state");
    assert!(warning.contains("no ownership can be inferred"));
    assert!(!warning.contains("re-tracked"));
    assert_eq!(std::fs::read_to_string(&path).expect("unchanged evidence"), "{not json");
    std::fs::remove_file(&path).expect("remove test fixture");
    std::fs::create_dir(&path).expect("unreadable inventory fixture");
    assert!(retired_pr_artifacts_warning(root.path()).expect("read refusal").contains("could not be read"));
    assert!(path.is_dir());
}
