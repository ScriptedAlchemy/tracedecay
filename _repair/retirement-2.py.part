def strip_retired(x):
 if isinstance(x,dict):
  x.pop('pr_autotrack',None)
  if isinstance(x.get('sync'),dict) and set(x['sync'])=={'auto_track_pr_branches','auto_track_pr_poll_secs'}:x.pop('sync')
  for v in x.values():strip_retired(v)
 elif isinstance(x,list):
  for v in x:strip_retired(v)
