#[test]
fn retired_autotrack_patches_are_refused_instead_of_ignored() {
    for sync in [
        json!({"auto_track_pr_branches": true}),
        json!({"auto_track_pr_poll_secs": 300}),
    ] {
        let failure = parse_project_settings_patch(json!({
            "expected_revision_id": "revision.project.1",
            "idempotency_key": "configuration.idempotency.retired",
            "sync": sync,
        }))
        .expect_err("retired fields must not appear to configure indexing");
        assert_eq!(failure.0, StatusCode::BAD_REQUEST);
        assert!(matches!(failure.1.0, DashboardConfigurationRefusalV1::Validation { .. }));
    }
}
