# Remove misleading old-state recovery advice. This diagnostic never resumes
# the retired feature and never claims a recorded path is safe to delete.
p='crates/tracedecay/src/doctor.rs';s=read(p)
a,b=item_range(s,'pr_autotrack_state_failure')
s=s[:a]+'''/// Reports recorded artifacts from the retired PR indexer without mutating or
/// adopting them. A ledger is evidence to inspect, never deletion authority.
fn retired_pr_artifacts_warning(data_root: &Path) -> Option<String> {
    #[derive(serde::Deserialize)]
    #[serde(deny_unknown_fields)]
    struct Inventory {
        managed: std::collections::BTreeMap<String, RecordedArtifacts>,
    }
    #[derive(serde::Deserialize)]
    #[serde(deny_unknown_fields)]
    struct RecordedArtifacts {
        pr: u64,
        head_branch: String,
        head_sha: String,
        worktree: std::path::PathBuf,
        tracking_ref: String,
    }

    let path = data_root.join("pr-autotrack.json");
    let bytes = match std::fs::read(&path) {
        Ok(bytes) => bytes,
        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return None,
        Err(error) => return Some(format!(
            "Automatic PR indexing is retired; artifact inventory {} could not be read ({error}). No artifacts were changed. Inspect the inventory before any cleanup.",
            path.display(),
        )),
    };
    let inventory: Inventory = match serde_json::from_slice(&bytes) {
        Ok(inventory) => inventory,
        Err(error) => return Some(format!(
            "Automatic PR indexing is retired; artifact inventory {} is invalid ({error}). No artifacts were changed and no ownership can be inferred. Preserve it for operator inspection.",
            path.display(),
        )),
    };
    let recorded = inventory.managed.into_iter().map(|(label, entry)| {
        format!(
            "PR {}: branch={label:?}, source_branch={:?}, worktree={:?}, tracking_ref={:?}, recorded_head={:?}",
            entry.pr, entry.head_branch, entry.worktree, entry.tracking_ref, entry.head_sha,
        )
    }).collect::<Vec<_>>().join("; ");
    Some(format!(
        "Automatic PR indexing is retired; inventory {} records [{}]. These records are not a current ownership proof. No worktrees, refs, or project data were changed. Follow docs/PR-AUTOTRACK-RETIREMENT.md; preserve dirty, foreign, or leased artifacts. Explicit branch add remains available.",
        path.display(), recorded,
    ))
}

'''+s[b:]
