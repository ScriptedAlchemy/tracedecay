  "macos_budget_basis": "Each group's budget is (1 min job setup + Linux warm compile x2 + Linux warm tests + 8 min cold-dependency allowance) x1.25, in minutes from run 34309279328 (ubuntu-24.04-arm, 4 vCPU). The 3-vCPU floor is compile x4/3; the one macOS measurement, run 34303181887, compiled the library chain beneath the root crate in 19.0 min against 9.3 on Arm (2.05x) and ran the whole suite in 19.9 min against ~19 across the Arm partitions (x1), so the budget takes the 2x. No group has run on macOS yet: replace these with measured wall time plus headroom after the first hosted run.",
  "macos_groups": [
    {
      "name": "root-lib",
      "timeout_minutes": 60,
      "budget_basis": "(1 + 14.7 compile x2 + 7.5 tests + 8) x1.25 = 57.4; the root chain, library test target and 1675 tests are the lane's floor, so nothing shares this job"
    },
    {
      "name": "root-suites",
      "timeout_minutes": 65,
      "budget_basis": "root-sessions 15.3 compile + 3.1 tests, then root-journeys on the same resolution adds only its own suites, 2.7 compile + 2.7 tests: (1 + 18.0 x2 + 5.8 + 8) x1.25 = 63.5"
    },
    {
      "name": "runtime-storage",
      "timeout_minutes": 85,
      "budget_basis": "runtime 15.6 compile + 2.4 tests, core-storage 10.4 + 1.9 on a different feature resolution: (1 + 26.0 x2 + 4.3 + 8) x1.25 = 81.6"
    },
    {
      "name": "contracts-dashboard-api",
      "timeout_minutes": 80,
      "budget_basis": "root-dashboard-api 12.7 compile + 0.8 tests, core-contracts 13.9 + 0.6 on a different feature resolution: (1 + 26.6 x2 + 1.4 + 8) x1.25 = 79.5"
    }
  ],
