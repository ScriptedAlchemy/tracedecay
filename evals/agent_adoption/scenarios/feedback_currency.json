{
  "id": "feedback_currency",
  "category": "feedback_behavior",
  "hosts": [
    "claude",
    "codex"
  ],
  "fixture": "main",
  "status": "active",
  "prompt": "What currency are order totals stored in, and is multi-currency supported? Base your answer on the project's recorded decisions.",
  "expected_tools": {
    "required_first": [
      "tracedecay_fact_store_search",
      "tracedecay_context"
    ],
    "acceptable": [
      "tracedecay_memory_status",
      "tracedecay_search"
    ],
    "forbidden_first": [
      "Grep",
      "Glob"
    ],
    "forbidden_bash": [
      "grep",
      "rg ",
      "rg\t",
      "find ",
      "cat ",
      "sed ",
      "awk ",
      "ack "
    ]
  },
  "outcome": {
    "kind": "answer",
    "answer": {
      "required": [
        {
          "id": "states USD",
          "pattern": "\\bUSD\\b"
        },
        {
          "id": "states multi-currency is not supported",
          "pattern": "multi-?currency[^.\\n]{0,60}(?:not|n't|rejected|unsupported|no )|(?:not|n't|rejected|unsupported|no )[^.\\n]{0,60}multi-?currency"
        }
      ],
      "forbidden": [
        {
          "id": "claims multi-currency is supported",
          "pattern": "multi-?currency\\W+(?:support\\w*\\W+)?(?:is|are)\\s+(?:fully\\s+)?(?:supported|available|enabled)"
        }
      ]
    }
  },
  "max_tool_calls": 5,
  "seeded_fact": "currency_fact_id",
  "grade_feedback": true,
  "notes": "A seeded fact directly answers the task. The feedback subscore checks whether the agent calls tracedecay_fact_feedback (action=helpful) on the seeded currency fact after relying on it. Baseline expectation: fail."
}
