{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "description": "Bazel's pnpm pin tracks packageManager; the shared branch name keeps both bumps in one PR",
      "customType": "regex",
      "managerFilePatterns": ["/^MODULE\\.bazel$/"],
      "matchStrings": ["pnpm\\.pnpm\\(pnpm_version = \"(?<currentValue>[^\"]+)\"\\)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Cargo lockfiles require the repository's external vendoring workflow",
      "matchManagers": ["cargo"],
      "enabled": false
    }
  ]
}
