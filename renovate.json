{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "description": "Bazel's pnpm pin tracks packageManager; the shared branch name keeps both bumps in one PR",
      "customType": "regex",
      "managerFilePatterns": ["/^MODULE\\.bazel$/"],
      "matchStrings": ["pnpm\\.pnpm\\(pnpm_version = \"(?<currentValue>[^\"]+)\"\\)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "description": "Workflow env pins annotated with a `# renovate:` comment on the line above",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+: \"?(?<currentValue>[^\\s\"]+)\"?"]
    },
    {
      "description": "rules_rust's compiler, formatter, and analyzer pins must match rust-toolchain.toml",
      "customType": "regex",
      "managerFilePatterns": ["/^MODULE\\.bazel$/"],
      "matchStrings": [
        "RUST_VERSION\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Cargo lockfiles require the repository's external vendoring workflow",
      "matchManagers": ["cargo"],
      "enabled": false
    },
    {
      "description": "One PR moves every Rust toolchain pin",
      "matchDepNames": ["rust"],
      "matchDatasources": ["rust-version"],
      "groupName": "rust toolchain",
      "separateMajorMinor": false
    }
  ]
}
