{
  "name": "@tracedecay/chatgpt-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ChatGPT extension (MCP server + MCP App) that bridges to the local TraceDecay daemon for code exploration and provenance-rich context.",
  "license": "MIT",
  "bin": {
    "tracedecay-chatgpt-extension": "./embedded/server.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:embedded": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/mcp-extensions": "^0.1.0",
    "@tracedecay/sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@rsbuild/core": "^2.2.12",
    "@rslib/core": "^1.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
