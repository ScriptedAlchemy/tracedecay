package(default_visibility = ["//visibility:public"])

# Rust crates embed these plugin host bundles via include_str! and
# compile_data.
filegroup(
    name = "sources",
    srcs = glob(["**/*"]),
)

filegroup(
    name = "opencode",
    srcs = glob(["opencode/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pi",
    srcs = glob(["pi/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pi_skill",
    srcs = glob(["pi/skill/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "skills_managing-session-context",
    srcs = glob(["skills/managing-session-context/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "skills_managing-session-context_references",
    srcs = glob(["skills/managing-session-context/references/**"]),
    visibility = ["//visibility:public"],
)
