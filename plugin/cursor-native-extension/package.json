{
  "name": "cursor-native",
  "displayName": "TraceDecay Cursor Native Diagnostics",
  "description": "Bridges Cursor's native diagnostics into the TraceDecay LSP gateway.",
  "publisher": "tracedecay",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "configuration": {
      "title": "TraceDecay",
      "properties": {
        "tracedecay.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the TraceDecay executable. Leave empty to use TRACEDECAY_BIN or tracedecay from PATH."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepackage": "node -e \"require('node:fs').rmSync('dist/tracedecay-cursor-native.vsix', { force: true })\"",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out dist/tracedecay-cursor-native.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
