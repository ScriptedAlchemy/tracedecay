{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "tracedecay hook-cursor-session-start",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "tracedecay hook-cursor-pre-compact",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "tracedecay hook-cursor-after-file-edit",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "tracedecay hook-cursor-stop",
        "timeout": 5
      }
    ]
  }
}
