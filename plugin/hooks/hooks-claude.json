{
  "description": "TraceDecay native lifecycle hooks: submit bounded edit, session, and stop events to the daemon.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TRACEDECAY_BIN__",
            "args": [
              "hook-stop"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TRACEDECAY_BIN__",
            "args": [
              "hook-claude-session-start"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__TRACEDECAY_BIN__",
            "args": [
              "hook-claude-post-tool-use"
            ]
          }
        ]
      }
    ]
  }
}
