diff --git a/npm/private/npm_package_extract.mjs b/npm/private/npm_package_extract.mjs
new file mode 100644
--- /dev/null
+++ b/npm/private/npm_package_extract.mjs
@@ -0,0 +1,22 @@
+import {spawnSync} from 'node:child_process';
+import {chmodSync, lstatSync, readdirSync} from 'node:fs';
+import {join} from 'node:path';
+
+const [tar, output, ...args] = process.argv.slice(2);
+const result = spawnSync(tar, args, {stdio: 'inherit'});
+if (result.error) throw result.error;
+if (result.status !== 0) process.exit(result.status ?? 1);
+
+// Match npm_import's a+X normalization before Bazel reads the TreeArtifact.
+// Repair each directory before descending; never follow package symlinks.
+function normalize(path) {
+    const stat = lstatSync(path);
+    if (stat.isSymbolicLink()) return;
+    if (stat.isDirectory() || (stat.mode & 0o111)) {
+        chmodSync(path, (stat.mode & 0o7777) | 0o111);
+    }
+    if (stat.isDirectory()) {
+        for (const name of readdirSync(path)) normalize(join(path, name));
+    }
+}
+if (process.platform !== 'win32') normalize(output);
