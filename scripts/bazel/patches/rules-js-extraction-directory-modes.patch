diff --git a/npm/private/npm_package_extract_test.mjs b/npm/private/npm_package_extract_test.mjs
new file mode 100644
--- /dev/null
+++ b/npm/private/npm_package_extract_test.mjs
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict';
+import {spawnSync} from 'node:child_process';
+import {chmodSync, mkdirSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync} from 'node:fs';
+import {join, resolve} from 'node:path';
+import {fileURLToPath} from 'node:url';
+
+// Explicit tar headers reproduce malformed registry directory modes without
+// requiring traversal of an unreadable source directory while archiving it.
+function entry(name, mode, type, content = '') {
+    const header = Buffer.alloc(512);
+    header.write(name);
+    function octal(value, offset, length) {
+        header.write(value.toString(8).padStart(length - 1, '0') + '\0', offset);
+    }
+    octal(mode, 100, 8);
+    octal(0, 108, 8);
+    octal(0, 116, 8);
+    octal(Buffer.byteLength(content), 124, 12);
+    octal(0, 136, 12);
+    header.fill(32, 148, 156);
+    header.write(type, 156);
+    header.write('ustar\0', 257);
+    header.write('00', 263);
+    octal(header.reduce((sum, byte) => sum + byte, 0), 148, 8);
+    const payload = Buffer.alloc(Math.ceil(Buffer.byteLength(content) / 512) * 512);
+    payload.write(content);
+    return Buffer.concat([header, payload]);
+}
+const root = mkdtempSync(join(process.env.TEST_TMPDIR, 'npm-extract-'));
+const output = join(root, 'output');
+mkdirSync(output);
+try {
+    const archive = join(root, 'fixture.tar');
+    writeFileSync(archive, Buffer.concat([
+        entry('package/', 0o755, '5'),
+        entry('package/lib/', 0o666, '5'),
+        entry('package/lib/nested/', 0o666, '5'),
+        entry('package/lib/nested/plain.js', 0o644, '0', 'plain'),
+        entry('package/lib/nested/executable.js', 0o710, '0', 'executable'),
+        Buffer.alloc(1024),
+    ]));
+    const helper = fileURLToPath(new URL('./npm_package_extract.mjs', import.meta.url));
+    const result = spawnSync(process.execPath, [helper, resolve(process.argv[2]), output,
+        '--extract', '--no-same-owner', '--no-same-permissions',
+        '--strip-components', '1', '--file', archive, '--directory', output,
+    ], {stdio: 'inherit'});
+    assert.equal(result.status, 0);
+    const nested = join(output, 'lib/nested');
+    assert.equal(readFileSync(join(nested, 'plain.js'), 'utf8'), 'plain');
+    if (process.platform !== 'win32') {
+        for (const dir of [join(output, 'lib'), nested]) {
+            assert.equal(statSync(dir).mode & 0o111, 0o111);
+        }
+        assert.equal(statSync(join(nested, 'plain.js')).mode & 0o111, 0);
+        assert.equal(statSync(join(nested, 'executable.js')).mode & 0o111, 0o111);
+    }
+} finally {
+    // Keep a failing old implementation from leaving nontraversable staging.
+    for (const dir of [join(output, 'lib'), join(output, 'lib/nested')]) {
+        try { chmodSync(dir, 0o755); } catch {}
+    }
+    rmSync(root, {recursive: true, force: true});
+}
