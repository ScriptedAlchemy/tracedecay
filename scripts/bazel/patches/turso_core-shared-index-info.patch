 #[inline]
+/// The key description of `index` for the cursor in slot `cursor_id`, built
+/// on the slot's first open and shared by every later execution. A reprepared
+/// program brings new `Index` values, which rebuild it.
+fn shared_index_info(
+    cache: &mut Vec<Option<(Arc<crate::schema::Index>, Arc<IndexInfo>)>>,
+    cursor_id: usize,
+    index: &Arc<crate::schema::Index>,
+) -> Result<Arc<IndexInfo>> {
+    if cache.len() <= cursor_id {
+        cache.resize(cursor_id + 1, None);
+    }
+    if let Some((cached, info)) = &cache[cursor_id] {
+        if Arc::ptr_eq(cached, index) {
+            return Ok(info.clone());
+        }
+    }
+    let info = Arc::new(IndexInfo::new_from_index(index)?);
+    cache[cursor_id] = Some((index.clone(), info.clone()));
+    Ok(info)
+}
