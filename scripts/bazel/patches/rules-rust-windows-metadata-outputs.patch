diff --git a/rust/private/rustc.bzl b/rust/private/rustc.bzl
--- a/rust/private/rustc.bzl
+++ b/rust/private/rustc.bzl
@@ -1928,6 +1928,16 @@
     # By default this is the binary output; if cc_common.link is used, this is
     # the main `.o` file (`output_o` below).
     outputs = [crate_info.output]
+    link_emit = emit
+    if toolchain.exec_triple.system == "windows" and (build_metadata or crate_info.type in ["lib", "rlib"]):
+        # Rustc validates the metadata path even for link-only rlib builds.
+        # Each action needs its own output instead of a sealed shared file.
+        linked_metadata = ctx.actions.declare_file(
+            crate_info.output.basename + ".rmeta",
+            sibling = crate_info.output,
+        )
+        link_emit = [kind for kind in emit if kind != "metadata"] + [("metadata", linked_metadata)]
+        outputs.append(linked_metadata)
 
     # The `.o` output file, only used for linking via cc_common.link.
     # When output_hash is set (e.g. for rust_test targets), include it in the
@@ -1990,7 +2000,7 @@
         toolchain = toolchain,
         tool_file = toolchain.rustc,
         cc_toolchain = cc_toolchain,
-        emit = emit,
+        emit = link_emit,
         feature_configuration = feature_configuration,
         crate_info = crate_info,
         dep_info = dep_info,
