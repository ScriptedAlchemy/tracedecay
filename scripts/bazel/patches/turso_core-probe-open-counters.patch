+pub mod open_probe {
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    pub const NAMES: [&str; 8] = ["schema_new", "schema_clone", "make_mut_clone", "btree_table_clone", "index_clone", "connect", "prepare", "reparse"];
+    pub static COUNTS: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+    pub fn cow() -> bool {
+        static COW: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        *COW.get_or_init(|| std::env::var_os("TURSO_SCHEMA_COW").is_some())
+    }
+    pub fn bump(slot: usize) { COUNTS[slot].fetch_add(1, Relaxed); }
+    pub fn counts() -> Vec<(&'static str, u64)> {
+        NAMES.iter().zip(COUNTS.iter()).map(|(n, c)| (*n, c.load(Relaxed))).collect()
+    }
+}
