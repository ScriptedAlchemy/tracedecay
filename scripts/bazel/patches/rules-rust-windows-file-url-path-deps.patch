diff --git a/crate_universe/src/metadata/metadata_annotation.rs b/crate_universe/src/metadata/metadata_annotation.rs
--- a/crate_universe/src/metadata/metadata_annotation.rs
+++ b/crate_universe/src/metadata/metadata_annotation.rs
@@ -280,6 +280,26 @@
                     if let Some(path_with_suffix) = node.id.repr.strip_prefix("path+file://") {
                         if let Some((path_in_lockfile, _suffix)) = path_with_suffix.rsplit_once('#')
                         {
+                            // Cargo renders path dependencies as `file:///`
+                            // URLs; on Windows these look like
+                            // `file:///C:/workspace/crate`, which strips to
+                            // `/C:/workspace/crate` - a root-relative path
+                            // whose first component is the drive letter. It
+                            // then fails `strip_prefix` against absolute
+                            // workspace paths and breaks later path joins.
+                            // Re-anchor it as `C:/workspace/crate`.
+                            let (path_in_lockfile, windows_drive_anchor) = {
+                                let bytes = path_in_lockfile.as_bytes();
+                                if bytes.len() >= 3
+                                    && bytes[0] == b'/'
+                                    && bytes[1].is_ascii_alphabetic()
+                                    && bytes[2] == b':'
+                                {
+                                    (&path_in_lockfile[1..], true)
+                                } else {
+                                    (path_in_lockfile, false)
+                                }
+                            };
                             let path = match Utf8Path::new(path_in_lockfile)
                                 .strip_prefix(&metadata.workspace_root)
                             {
@@ -321,5 +341,15 @@
                                 Err(_) => Utf8PathBuf::from(path_in_lockfile),
                             };
+                            // On Windows, paths display with `\` joins, which
+                            // are invalid escape sequences inside the Starlark
+                            // and JSON strings this annotation is rendered
+                            // into. `/` is accepted by every Windows
+                            // filesystem API, so emit the canonical form.
+                            let path = if windows_drive_anchor {
+                                Utf8PathBuf::from(path.as_str().replace('\\', "/"))
+                            } else {
+                                path
+                            };
                             return Ok(SourceAnnotation::Path { path });
                         }
                     }
