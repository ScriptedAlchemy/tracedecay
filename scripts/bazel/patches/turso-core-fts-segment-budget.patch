 /// Memory budget for Tantivy's per-segment writer arena.
 pub const DEFAULT_MEMORY_BUDGET_BYTES: usize = 64 * 1024 * 1024;
 
+/// Tantivy sizes a segment writer's term tables from its memory budget, so
+/// the full budget allocates, zeroes and finally scans 2^19-entry tables for
+/// every statement flush, even a one-row INSERT. Size the budget by the
+/// documents being flushed; the tables still grow when a batch needs more.
+fn segment_memory_budget(documents: usize) -> usize {
+    documents
+        .saturating_mul(64 * 1024)
+        .clamp(1024 * 1024, DEFAULT_MEMORY_BUDGET_BYTES)
+}
+
 /// Chunk size (512 KiB) for splitting segment files into backing rows.
 pub const DEFAULT_CHUNK_SIZE: usize = 512 * 1024;
 
