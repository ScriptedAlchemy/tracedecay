package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "linux",
        "cpu_arch": "x86_64",
        "cpu_count": "1",
    },
)

platform(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    exec_properties = {
        "OSFamily": "darwin",
        "cpu_arch": "aarch64",
        "cpu_count": "1",
    },
)
