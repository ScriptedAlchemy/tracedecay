{
  "schema_version": 1,
  "workload_id": "storage-runtime-runner-dry-run-v1",
  "evidence_eligible": false,
  "description": "Self-contained dry-run for the S0 baseline runner. Every step is a stdlib python3 one-liner operating on a synthetic runner-owned fixture; it carries no TraceDecay product protocol fields and needs no daemon, no store, and no tracedecay binary.",
  "store_families": ["sample"],
  "binary": null,
  "frozen_identity": {
    "required_for_evidence": false
  },
  "environment": {
    "version_commands": {
      "python3": ["__PYTHON__", "--version"]
    }
  },
  "safety": {
    "env": {},
    "env_path_keys": []
  },
  "defaults": {
    "warmup": 1,
    "repetitions": 5,
    "timeout_seconds": 30
  },
  "phases": [
    {
      "name": "current",
      "kind": "closed_loop",
      "families": ["sample"],
      "scale_factor": 1,
      "setup": {
        "argv": ["__PYTHON__", "-c", "import pathlib,sys; pathlib.Path(sys.argv[1]).write_text('seed')", "__RUN_DIR__/store.txt"]
      },
      "work": {
        "argv": ["__PYTHON__", "-c", "import pathlib,sys; p=pathlib.Path(sys.argv[1]); p.write_text(p.read_text()+'x')", "__RUN_DIR__/store.txt"]
      },
      "repetitions": 5,
      "warmup": 1,
      "evidence": [
        {"name": "store_state", "capture": "logical_file", "path": "__RUN_DIR__/store.txt"}
      ]
    },
    {
      "name": "ten_x",
      "kind": "closed_loop",
      "families": ["sample"],
      "scale_factor": 10,
      "setup": {
        "argv": ["__PYTHON__", "-c", "import pathlib,sys; pathlib.Path(sys.argv[1]).write_text('seed')", "__RUN_DIR__/store.txt"]
      },
      "work": {
        "argv": ["__PYTHON__", "-c", "import pathlib,sys; p=pathlib.Path(sys.argv[1]); p.write_text(p.read_text()+'xxxxxxxxxx')", "__RUN_DIR__/store.txt"]
      },
      "repetitions": 5,
      "warmup": 1,
      "evidence": [
        {"name": "store_state", "capture": "logical_file", "path": "__RUN_DIR__/store.txt"}
      ]
    },
    {
      "name": "overload",
      "kind": "open_loop",
      "families": ["sample"],
      "work": {
        "argv": ["__PYTHON__", "-c", "import time; time.sleep(0.005)"]
      },
      "offered_rate_per_second": 10000,
      "operation_count": 20,
      "max_in_flight": 1,
      "max_retries": 1,
      "retryable_outcomes": ["shed"],
      "outcome_map": {"0": "completed"}
    },
    {
      "name": "crash",
      "kind": "crash",
      "families": ["sample"],
      "setup": {
        "argv": ["__PYTHON__", "-c", "import pathlib,sys; pathlib.Path(sys.argv[1]).write_text('authoritative-bytes')", "__RUN_DIR__/store.txt"]
      },
      "work": {
        "argv": ["__PYTHON__", "-c", "import pathlib,sys,time; pathlib.Path(sys.argv[1]).write_text('up'); time.sleep(60)", "__RUN_DIR__/marker"]
      },
      "wait_for_file": "__RUN_DIR__/marker",
      "wait_timeout_seconds": 15,
      "post_crash_evidence": [
        {"name": "store_state", "capture": "logical_file", "path": "__RUN_DIR__/store.txt"}
      ]
    },
    {
      "name": "recovery",
      "kind": "recovery",
      "families": ["sample"],
      "depends_on": "crash",
      "recover": {
        "argv": ["__PYTHON__", "-c", "import pathlib,sys; data=pathlib.Path(sys.argv[1]).read_text(); sys.exit(0 if data=='authoritative-bytes' else 1)", "__RUN_DIR__/store.txt"]
      },
      "evidence": [
        {"name": "store_state", "capture": "logical_file", "path": "__RUN_DIR__/store.txt"}
      ],
      "compare": [
        {"a": "crash:store_state", "b": "store_state", "expect": "equal"}
      ]
    },
    {
      "name": "fts",
      "kind": "closed_loop",
      "families": ["sample"],
      "work": {
        "argv": ["__PYTHON__", "-c", "print('token-alpha token-beta')"]
      },
      "repetitions": 3,
      "warmup": 0,
      "evidence": [
        {"name": "probe_a", "capture": "stdout_redacted", "argv": ["__PYTHON__", "-c", "print('token-alpha token-beta')"]},
        {"name": "probe_b", "capture": "stdout_redacted", "argv": ["__PYTHON__", "-c", "print('token-alpha token-beta')"]}
      ],
      "compare": [
        {"a": "probe_a", "b": "probe_b", "expect": "equal"}
      ]
    },
    {
      "name": "backup_restore",
      "kind": "backup_restore",
      "families": ["sample"],
      "setup": {
        "argv": ["__PYTHON__", "-c", "import pathlib,sys; pathlib.Path(sys.argv[1]).write_text('backup-me')", "__RUN_DIR__/store.txt"]
      },
      "steps": [
        {"name": "backup", "argv": ["__PYTHON__", "-c", "import pathlib,shutil,sys; pathlib.Path(sys.argv[2]).parent.mkdir(parents=True,exist_ok=True); shutil.copy2(sys.argv[1], sys.argv[2])", "__RUN_DIR__/store.txt", "__RUN_DIR__/staging/store.txt"]},
        {"name": "restore", "argv": ["__PYTHON__", "-c", "import pathlib,shutil,sys; pathlib.Path(sys.argv[2]).parent.mkdir(parents=True,exist_ok=True); shutil.copy2(sys.argv[1], sys.argv[2])", "__RUN_DIR__/staging/store.txt", "__RUN_DIR__/restored/store.txt"]}
      ],
      "evidence": [
        {"name": "original_state", "capture": "logical_file", "path": "__RUN_DIR__/store.txt"},
        {"name": "backup_state", "capture": "logical_file", "path": "__RUN_DIR__/staging/store.txt"},
        {"name": "restored_state", "capture": "logical_file", "path": "__RUN_DIR__/restored/store.txt"}
      ],
      "compare": [
        {"a": "original_state", "b": "backup_state", "expect": "equal"},
        {"a": "original_state", "b": "restored_state", "expect": "equal"}
      ]
    },
    {
      "name": "aa_noise",
      "kind": "aa_pairs",
      "families": ["sample"],
      "target_phase": "current",
      "pairs": 2,
      "margin_multiplier": 2.0
    }
  ],
  "limitations": [
    "dry-run exercises runner machinery only; it is not product baseline evidence"
  ]
}
