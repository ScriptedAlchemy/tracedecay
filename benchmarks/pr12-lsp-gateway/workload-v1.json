{
  "version": 1,
  "workload_id": "pr12-lsp-gateway-v1",
  "scope": "single-root daemon LSP gateway warm actor",
  "architecture": {
    "session_owner": "src/daemon/service/invocation.rs::DaemonInvocationService",
    "protocol_actor": "src/daemon/lsp_gateway/protocol.rs::DaemonLspProtocolSession",
    "feedback_authority": "src/daemon/lsp_gateway/gateway.rs::FeedbackCyclePort",
    "diagnostic_projection": "src/daemon/lsp_gateway/provider.rs::DiagnosticSnapshotPort",
    "semantic_navigation": "src/daemon/lsp_gateway/gateway.rs::SemanticProviderPort",
    "transport_bridge": "src/lsp_cmd.rs::run_stdio_bridge",
    "invariants": [
      "one authenticated daemon-owned session per admitted root",
      "document save and document diagnostic use the same feedback-cycle authority",
      "accepted feedback is visible through the canonical diagnostic snapshot before projection",
      "navigation delegates to the negotiated semantic provider",
      "the gateway owns no finding store, analyzer process, database, or policy authority"
    ]
  },
  "acceptance_scenarios": [
    {
      "id": "diagnostics.pull",
      "method": "textDocument/diagnostic",
      "path": "request feedback cycle -> read canonical generation -> bounded UTF-16 projection"
    },
    {
      "id": "diagnostics.push",
      "method": "textDocument/didSave",
      "path": "request feedback cycle -> canonical generation -> textDocument/publishDiagnostics"
    },
    {
      "id": "navigation.definition",
      "method": "textDocument/definition",
      "path": "negotiated SemanticProviderPort -> root-confined locations"
    },
    {
      "id": "navigation.references",
      "method": "textDocument/references",
      "path": "negotiated SemanticProviderPort -> bounded complete or partial response"
    },
    {
      "id": "navigation.hover",
      "method": "textDocument/hover",
      "path": "negotiated SemanticProviderPort -> canonical hover response"
    },
    {
      "id": "feedback.same-authority",
      "method": "textDocument/diagnostic",
      "path": "FeedbackCyclePort -> FeedbackCycleService -> DiagnosticSnapshotPort"
    }
  ],
  "repetitions": 30,
  "warmups": 5,
  "request_mix": {
    "initialize_initialized": 1,
    "did_open": 1,
    "did_save": 2,
    "incremental_did_change": 20,
    "text_document_diagnostic": 10,
    "text_document_definition": 4,
    "text_document_references": 3,
    "text_document_hover": 3,
    "did_close": 1,
    "reconnect": 1,
    "expiry": 1
  },
  "limits": {
    "lsp_frame_bytes": 4194304,
    "lsp_header_bytes": 16384,
    "overlay_bytes": 2097152,
    "open_documents": 128,
    "pending_overlay_diagnostics": 128,
    "publication_bytes": 262144,
    "queued_session_bytes": 1048576,
    "queued_session_messages": 64,
    "pending_requests": 64,
    "overlay_debounce_ms": 50,
    "overlay_max_wait_ms": 200
  },
  "latency_budget_ms": {
    "queue_to_bridge_p95": 100,
    "queue_to_bridge_p99": 250,
    "diagnostic_publication_p95": 500,
    "diagnostic_publication_p99": 1500
  },
  "required_metrics": [
    "wall_clock_ns",
    "cpu_user_system_ticks",
    "peak_rss_bytes",
    "queued_bytes",
    "queued_messages",
    "overlay_bytes",
    "publication_bytes",
    "superseded_publications",
    "backpressure_events",
    "reconnects",
    "expirations"
  ],
  "exclusions": [
    "analyzer_spawn",
    "analyzer_indexing",
    "database_open",
    "host_plugin_startup",
    "network_transport"
  ],
  "protocol_gate": [
    "cargo",
    "test",
    "--test",
    "hooks_lsp_suite",
    "lsp_gateway_protocol",
    "--",
    "--nocapture"
  ]
}
