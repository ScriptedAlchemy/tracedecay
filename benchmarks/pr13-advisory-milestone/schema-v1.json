{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tracedecay.dev/schemas/pr13-advisory-milestone-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload_id",
    "schema",
    "ci_mode",
    "static_gate_ids",
    "ci_gate_ids",
    "behavioral_contract",
    "provider_gaps",
    "host_packet",
    "ci_gate_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workload_id": { "const": "pr13-advisory-milestone-acceptance-v1" },
    "schema": { "const": "benchmarks/pr13-advisory-milestone/schema-v1.json" },
    "ci_mode": { "const": "strict" },
    "static_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["advisory_packet_json", "advisory_references"]
      }
    },
    "ci_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "pr13_advisory_compile",
          "pr13_advisory_schema",
          "pr13_advisory_runtime_decoders",
          "pr13_advisory_pagination_cas",
          "pr13_advisory_proximity_pillar",
          "pr13_advisory_structure",
          "pr13_advisory_no_secret"
        ]
      }
    },
    "behavioral_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "runtime_test",
        "symbol",
        "pillars",
        "terminal",
        "provider_mutation"
      ],
      "properties": {
        "test": {
          "const": "crates/tracedecay-application/tests/four_pillar_milestone.rs"
        },
        "runtime_test": {
          "const": "tests/pr13_advisory_runtime_acceptance.rs"
        },
        "symbol": {
          "const": "four_pillars_share_one_cycle_result_and_reference_identities"
        },
        "pillars": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "post_edit_diagnostic_and_impact",
              "ci_failure_localization",
              "existing_github_review",
              "agent_proximity"
            ]
          }
        },
        "terminal": { "const": "blocked_one_shot" },
        "provider_mutation": { "const": "absent" }
      }
    },
    "provider_gaps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "github.pagination_cas",
          "proximity.overlap_tiering"
        ]
      }
    },
    "host_packet": {
      "const": "benchmarks/pr13-host-conformance/workload-v1.json"
    },
    "ci_gate_status": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 7,
      "maxProperties": 7,
      "properties": {
        "pr13_advisory_compile": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_advisory_schema": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_advisory_runtime_decoders": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_advisory_pagination_cas": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_advisory_proximity_pillar": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_advisory_structure": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_advisory_no_secret": { "$ref": "#/definitions/checkedInGateState" }
      },
      "required": [
        "pr13_advisory_compile",
        "pr13_advisory_schema",
        "pr13_advisory_runtime_decoders",
        "pr13_advisory_pagination_cas",
        "pr13_advisory_proximity_pillar",
        "pr13_advisory_structure",
        "pr13_advisory_no_secret"
      ]
    }
  },
  "definitions": {
    "checkedInGateState": {
      "type": "string",
      "enum": ["awaiting_ci", "failed"]
    }
  }
}
