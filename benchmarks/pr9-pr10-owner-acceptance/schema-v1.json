{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracedecay.pr9-pr10-owner-acceptance.packet.v1",
  "title": "PR9/PR10 owner-acceptance packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "authority",
    "candidate_is_not_label_authority",
    "source_repository_commit",
    "source_repository_tree",
    "partition_seed",
    "score_scale",
    "corpus",
    "protected_classes",
    "profile_matrix",
    "decision_policy",
    "queries"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_id": { "const": "pr9-pr10-owner-acceptance-v1" },
    "authority": { "type": "string", "minLength": 1 },
    "candidate_is_not_label_authority": { "const": true },
    "source_repository_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_repository_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fixture_checkpoint_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "partition_seed": { "type": "integer", "minimum": 1 },
    "score_scale": { "const": 1000000 },
    "corpus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "path", "scope", "language", "eligibility"],
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "eligibility": { "type": "string", "minLength": 1 }
        }
      }
    },
    "history_evidence": { "type": "array" },
    "protected_classes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "profile_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profile_id"],
        "properties": {
          "profile_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "required": [
        "low_support_outcome",
        "invariant_failure_outcome",
        "missing_production_or_resource_evidence_outcome"
      ],
      "properties": {
        "low_support_outcome": { "const": "inconclusive" },
        "invariant_failure_outcome": { "const": "rejected" },
        "missing_production_or_resource_evidence_outcome": { "const": "blocked" }
      }
    },
    "resource_budgets": { "type": "object" },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["query_id", "partition", "strata", "query", "allowed_scopes"],
        "properties": {
          "query_id": { "type": "string", "minLength": 1 },
          "partition": {
            "enum": ["train", "validation", "sealed_holdout"]
          },
          "strata": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "query": { "type": "string", "minLength": 1 },
          "allowed_scopes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "label": { "type": "object" }
        }
      }
    },
    "owner_decision": {
      "type": "string",
      "description": "Optional path to an owner_decision_v1 JSON record. Absence means no acceptance has been issued."
    }
  }
}
