{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tracedecay.dev/schemas/pr13-host-conformance-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload_id",
    "schema",
    "ci_mode",
    "static_gate_ids",
    "ci_gate_ids",
    "embedded_bundle",
    "hosts",
    "checkpoint_outcomes",
    "external_host_executables",
    "install_contracts",
    "platform_contracts",
    "red_gaps",
    "ci_gate_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workload_id": { "const": "pr13-host-conformance-v1" },
    "schema": { "const": "benchmarks/pr13-host-conformance/schema-v1.json" },
    "ci_mode": { "const": "strict" },
    "static_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "host_packet_json",
          "host_fixture_references"
        ]
      }
    },
    "ci_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "pr11_project_open_runtime",
          "pr12_git_cli_runtime",
          "pr12_git_mcp_runtime",
          "pr12_git_http_runtime",
          "pr12_http_sse_stream",
          "pr12_lsp_gateway_runtime",
          "pr12_feedback_handle_bootstrap",
          "pr12_primitives_config_parity",
          "pr12_cancellation_capacity_resume",
          "pr13_host_schema",
          "pr13_host_decoders",
          "pr13_daemon_runtime_pipeline",
          "pr13_host_receipt_doctor",
          "pr13_host_structure",
          "pr13_host_no_secret",
          "pr13_lite_grammar_contract",
          "cursor_native_extension_check",
          "cursor_native_extension_test",
          "cursor_native_extension_package",
          "cursor_native_extension_receipt",
          "cursor_native_extension_runtime",
          "platform_linux_lifecycle",
          "platform_windows_lifecycle",
          "platform_macos_lifecycle"
        ]
      }
    },
    "embedded_bundle": { "$ref": "#/definitions/embeddedBundle" },
    "hosts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/definitions/host" }
    },
    "checkpoint_outcomes": { "$ref": "#/definitions/checkpointOutcomes" },
    "external_host_executables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kiro", "cline", "roo_code", "kilo"],
      "properties": {
        "kiro": { "const": "not_authenticated" },
        "cline": { "const": "not_installed" },
        "roo_code": { "const": "not_installed" },
        "kilo": { "const": "not_installed" }
      }
    },
    "install_contracts": { "$ref": "#/definitions/installContracts" },
    "platform_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "windows", "macos"],
      "properties": {
        "linux": { "const": "ci_matrix_required" },
        "windows": { "const": "ci_matrix_required" },
        "macos": { "const": "ci_matrix_required" }
      }
    },
    "red_gaps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex.edit",
          "cursor_desktop.stop",
          "kiro.edit",
          "kiro.stop",
          "cursor_cloud.edit",
          "cursor_cloud.stop",
          "cline_family.edit",
          "cline_family.stop"
        ]
      }
    },
    "ci_gate_status": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 24,
      "maxProperties": 24,
      "properties": {
        "pr11_project_open_runtime": { "$ref": "#/definitions/checkedInGateState" },
        "pr12_git_cli_runtime": { "$ref": "#/definitions/checkedInGateState" },
        "pr12_git_mcp_runtime": { "$ref": "#/definitions/checkedInGateState" },
        "pr12_git_http_runtime": { "$ref": "#/definitions/checkedInGateState" },
        "pr12_http_sse_stream": { "$ref": "#/definitions/checkedInGateState" },
        "pr12_lsp_gateway_runtime": { "$ref": "#/definitions/checkedInGateState" },
        "pr12_feedback_handle_bootstrap": { "$ref": "#/definitions/checkedInGateState" },
        "pr12_primitives_config_parity": { "$ref": "#/definitions/checkedInGateState" },
        "pr12_cancellation_capacity_resume": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_host_schema": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_host_decoders": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_daemon_runtime_pipeline": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_host_receipt_doctor": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_host_structure": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_host_no_secret": { "$ref": "#/definitions/checkedInGateState" },
        "pr13_lite_grammar_contract": { "$ref": "#/definitions/checkedInGateState" },
        "cursor_native_extension_check": { "$ref": "#/definitions/checkedInGateState" },
        "cursor_native_extension_test": { "$ref": "#/definitions/checkedInGateState" },
        "cursor_native_extension_package": { "$ref": "#/definitions/checkedInGateState" },
        "cursor_native_extension_receipt": { "$ref": "#/definitions/checkedInGateState" },
        "cursor_native_extension_runtime": { "$ref": "#/definitions/checkedInGateState" },
        "platform_linux_lifecycle": { "$ref": "#/definitions/checkedInGateState" },
        "platform_windows_lifecycle": { "$ref": "#/definitions/checkedInGateState" },
        "platform_macos_lifecycle": { "$ref": "#/definitions/checkedInGateState" }
      },
      "required": [
        "pr11_project_open_runtime",
        "pr12_git_cli_runtime",
        "pr12_git_mcp_runtime",
        "pr12_git_http_runtime",
        "pr12_http_sse_stream",
        "pr12_lsp_gateway_runtime",
        "pr12_feedback_handle_bootstrap",
        "pr12_primitives_config_parity",
        "pr12_cancellation_capacity_resume",
        "pr13_host_schema",
        "pr13_host_decoders",
        "pr13_daemon_runtime_pipeline",
        "pr13_host_receipt_doctor",
        "pr13_host_structure",
        "pr13_host_no_secret",
        "pr13_lite_grammar_contract",
        "cursor_native_extension_check",
        "cursor_native_extension_test",
        "cursor_native_extension_package",
        "cursor_native_extension_receipt",
        "cursor_native_extension_runtime",
        "platform_linux_lifecycle",
        "platform_windows_lifecycle",
        "platform_macos_lifecycle"
      ]
    }
  },
  "definitions": {
    "checkedInGateState": {
      "type": "string",
      "enum": ["awaiting_ci", "failed"]
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "event", "capture", "provenance"],
          "properties": {
            "state": { "const": "evidenced" },
            "event": { "type": "string", "minLength": 1 },
            "capture": { "type": "string", "minLength": 1 },
            "provenance": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "edit", "stop"],
      "properties": {
        "id": {
          "enum": [
            "claude_code",
            "codex",
            "cursor_desktop",
            "hermes",
            "kiro",
            "cursor_cloud",
            "cline_family",
            "kimi_code",
            "opencode"
          ]
        },
        "edit": { "$ref": "#/definitions/event" },
        "stop": { "$ref": "#/definitions/event" }
      }
    },
    "embeddedBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "loading", "external_third_party", "checks", "lifecycle"],
      "properties": {
        "source": { "const": "first_party_binary_embedded" },
        "loading": { "const": "embedded_only" },
        "external_third_party": { "const": "rejected" },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "schema",
              "version",
              "host_component_capability",
              "artifact_digest",
              "receipt_digest"
            ]
          }
        },
        "lifecycle": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ownership",
              "explicit_confirmation",
              "receipt",
              "backup",
              "interrupted_recovery",
              "rollback"
            ]
          }
        }
      }
    },
    "checkpointOutcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kiro", "kimi", "hermes", "opencode"],
      "properties": {
        "kiro": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cli_version", "config_validation", "supported_hooks", "auth"],
          "properties": {
            "cli_version": { "const": "2.13.0" },
            "config_validation": { "const": "passed" },
            "supported_hooks": {
              "type": "array",
              "items": { "enum": ["write", "stop"] },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "auth": { "const": "whoami_not_logged_in_and_no_KIRO_API_KEY" }
          }
        },
        "kimi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doctor", "manifest_restore"],
          "properties": {
            "doctor": { "const": "passed" },
            "manifest_restore": { "const": "byte_identical" }
          }
        },
        "hermes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doctor", "config_restore"],
          "properties": {
            "doctor": { "const": "passed" },
            "config_restore": { "const": "passed" }
          }
        },
        "opencode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doctor", "config_restore"],
          "properties": {
            "doctor": { "const": "passed" },
            "config_restore": { "const": "passed" }
          }
        }
      }
    },
    "installContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claude_packages",
        "cursor_packages",
        "cursor_native_extension",
        "cline_global_mcp",
        "kimi",
        "opencode"
      ],
      "properties": {
        "claude_packages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cursor_packages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cursor_native_extension": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "built_javascript",
            "vsix",
            "installed_path",
            "lsp_command",
            "capability",
            "diagnostic_limit",
            "message_byte_limit",
            "workspace_policy",
            "multi_root_policy",
            "merge_policy",
            "reconnect_policy",
            "clear_policy",
            "teardown_policy",
            "receipt_doctor"
          ],
          "properties": {
            "package": { "const": "plugin/cursor-native-extension/package.json" },
            "built_javascript": {
              "const": "plugin/cursor-native-extension/dist/extension.js"
            },
            "vsix": {
              "const": "plugin/cursor-native-extension/dist/tracedecay-cursor-native.vsix"
            },
            "installed_path": {
              "const": ".cursor/extensions/tracedecay.cursor-native-0.0.0"
            },
            "lsp_command": {
              "const": ["tracedecay", "lsp", "bridge", "--stdio"]
            },
            "capability": { "const": "supported" },
            "diagnostic_limit": { "const": 100 },
            "message_byte_limit": { "const": 512 },
            "workspace_policy": { "const": "single_trusted_file_workspace" },
            "multi_root_policy": { "const": "typed_unavailable" },
            "merge_policy": {
              "const": "cursor_native_tracedecay_only_without_upstream_echo"
            },
            "reconnect_policy": {
              "const": "resend_current_diagnostics_and_preserve_gateway_lane"
            },
            "clear_policy": { "const": "change_and_close_clear_native_lane" },
            "teardown_policy": {
              "const": "dispose_subscriptions_stop_client_and_clear_gateway_state"
            },
            "receipt_doctor": { "const": "agent_component_registration" }
          }
        },
        "cline_global_mcp": { "const": ".cline/data/settings/cline_mcp_settings.json" },
        "kimi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plugin", "registry", "global_mcp", "local_mcp", "skills_commands"],
          "properties": {
            "plugin": { "const": "plugins/managed/tracedecay" },
            "registry": { "const": "plugins/installed.json" },
            "global_mcp": { "const": "inline_plugin_manifest" },
            "local_mcp": { "const": ".kimi-code/mcp.json" },
            "skills_commands": { "const": "embedded_plugin" }
          }
        },
        "opencode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "global_mcp",
            "local_mcp",
            "commands",
            "agent_prompts",
            "rules",
            "independent_prompt_component",
            "plugin_capture",
            "custom_lsp_command",
            "duplicate_analyzer",
            "activation"
          ],
          "properties": {
            "global_mcp": { "const": ".config/opencode/opencode.json" },
            "local_mcp": { "const": "opencode.json" },
            "commands": { "const": "prompt_templates" },
            "agent_prompts": { "const": "agent_owned_referenced_files" },
            "rules": { "const": "AGENTS_and_config_instructions" },
            "independent_prompt_component": { "const": "absent" },
            "plugin_capture": { "type": "string", "minLength": 1 },
            "custom_lsp_command": {
              "const": ["tracedecay", "lsp", "bridge", "--stdio"]
            },
            "duplicate_analyzer": {
              "const": "must_not_start_or_claim_second_language_analyzer"
            },
            "activation": { "const": "after_official_dogfood" }
          }
        }
      }
    }
  }
}
