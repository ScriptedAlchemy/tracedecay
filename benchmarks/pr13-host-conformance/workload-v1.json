      "stop": {
        "state": "unavailable",
        "reason": "no_installed_cline_roo_or_kilo_host_on_capture_machine"
      }
    },
    {
      "id": "kimi_code",
      "edit": {
        "state": "evidenced",
        "event": "PostToolUse/Edit",
        "capture": "crates/tracedecay-hooks/fixtures/host_events/kimi/post-tool-use-edit.json",
        "provenance": "crates/tracedecay-hooks/fixtures/host_events/kimi/README.md"
