      "stop": {
        "state": "evidenced",
        "event": "Stop",
        "capture": "crates/tracedecay-hooks/fixtures/host_events/kimi/stop.json",
        "provenance": "crates/tracedecay-hooks/fixtures/host_events/kimi/README.md"
      }
