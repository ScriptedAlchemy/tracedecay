  "checkpoint_outcomes": {
    "kiro": {
      "cli_version": "2.13.0",
      "config_validation": "passed",
      "supported_hooks": [
        "write",
        "stop"
      ],
      "auth": "whoami_not_logged_in_and_no_KIRO_API_KEY"
    },
    "kimi": {
      "doctor": "passed",
      "manifest_restore": "byte_identical"
    },
    "hermes": {
      "doctor": "passed",
      "config_restore": "passed"
    },
    "opencode": {
      "doctor": "passed",
      "config_restore": "passed"
    }
  },
  "external_host_executables": {
    "kiro": "not_authenticated",
    "cline": "not_installed",
    "roo_code": "not_installed",
    "kilo": "not_installed"
  },
  "install_contracts": {
    "claude_packages": [
      "plugin/.lsp.json",
      "plugin/hooks/hooks-claude.json",
      "plugin/.mcp.json"
    ],
    "cursor_packages": [
      "plugin/hooks/hooks-cursor.json",
      "plugin/mcp-cursor.json"
    ],
    "cursor_native_extension": {
      "package": "plugin/cursor-native-extension/package.json",
      "built_javascript": "plugin/cursor-native-extension/dist/extension.js",
      "vsix": "plugin/cursor-native-extension/dist/tracedecay-cursor-native.vsix",
      "installed_path": ".cursor/extensions/tracedecay.cursor-native-0.0.0",
      "lsp_command": [
        "tracedecay",
        "lsp",
        "bridge",
        "--stdio"
      ],
      "capability": "supported",
      "diagnostic_limit": 100,
      "message_byte_limit": 512,
      "workspace_policy": "single_trusted_file_workspace",
      "multi_root_policy": "typed_unavailable",
      "merge_policy": "cursor_native_tracedecay_only_without_upstream_echo",
      "reconnect_policy": "resend_current_diagnostics_and_preserve_gateway_lane",
      "clear_policy": "change_and_close_clear_native_lane",
      "teardown_policy": "dispose_subscriptions_stop_client_and_clear_gateway_state",
      "receipt_doctor": "agent_component_registration"
    },
    "cline_global_mcp": ".cline/data/settings/cline_mcp_settings.json",
    "kimi": {
      "plugin": "plugins/managed/tracedecay",
      "registry": "plugins/installed.json",
      "global_mcp": "inline_plugin_manifest",
      "local_mcp": ".kimi-code/mcp.json",
      "skills_commands": "embedded_plugin"
    },
    "opencode": {
      "global_mcp": ".config/opencode/opencode.json",
      "local_mcp": "opencode.json",
      "commands": "prompt_templates",
      "agent_prompts": "agent_owned_referenced_files",
      "rules": "AGENTS_and_config_instructions",
      "independent_prompt_component": "absent",
      "plugin_capture": "crates/tracedecay-hooks/fixtures/host_events/opencode/baseline.json",
      "custom_lsp_command": [
        "tracedecay",
        "lsp",
        "bridge",
        "--stdio"
      ],
      "duplicate_analyzer": "must_not_start_or_claim_second_language_analyzer",
      "activation": "after_official_dogfood"
    }
  },
  "platform_contracts": {
    "linux": "ci_matrix_required",
    "windows": "ci_matrix_required",
    "macos": "ci_matrix_required"
  },
  "red_gaps": [
