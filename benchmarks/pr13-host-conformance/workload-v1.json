      "stop": {
        "state": "unavailable",
        "reason": "kiro_auth_blocked_no_authentic_native_stop_capture"
      }
    },
    {
      "id": "cursor_cloud",
      "edit": {
        "state": "unavailable",
        "reason": "no_checked_in_authentic_cursor_cloud_edit_capture"
      },
      "stop": {
        "state": "unavailable",
        "reason": "no_checked_in_authentic_cursor_cloud_stop_capture"
      }
    },
    {
      "id": "cline_family",
      "edit": {
        "state": "unavailable",
