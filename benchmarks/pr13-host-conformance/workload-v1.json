      },
      "stop": {
        "state": "unavailable",
        "reason": "authentic_cursor_process_did_not_invoke_configured_stop_hook"
      }
    },
    {
      "id": "hermes",
      "edit": {
        "state": "evidenced",
        "event": "post_tool_call/write_file",
        "capture": "crates/tracedecay-hooks/fixtures/host_events/hermes/saved-edit.json",
        "provenance": "crates/tracedecay-hooks/fixtures/host_events/hermes.json"
      },
      "stop": {
        "state": "evidenced",
        "event": "on_session_end",
        "capture": "crates/tracedecay-hooks/fixtures/host_events/hermes/stop.json",
        "provenance": "crates/tracedecay-hooks/fixtures/host_events/hermes.json"
      }
    },
    {
      "id": "kiro",
      "edit": {
        "state": "unavailable",
