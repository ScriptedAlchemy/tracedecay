    {
      "id": "opencode",
      "edit": {
        "state": "evidenced",
        "event": "file.edited+tool.execute.after",
        "capture": "crates/tracedecay-hooks/fixtures/host_events/opencode/baseline.json",
        "provenance": "crates/tracedecay-hooks/fixtures/host_events/opencode/baseline.json"
