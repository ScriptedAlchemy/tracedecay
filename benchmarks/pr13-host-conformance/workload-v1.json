  "embedded_bundle": {
    "source": "first_party_binary_embedded",
    "loading": "embedded_only",
    "external_third_party": "rejected",
    "checks": [
      "schema",
      "version",
      "host_component_capability",
      "artifact_digest",
      "receipt_digest"
    ],
    "lifecycle": [
      "ownership",
      "explicit_confirmation",
      "receipt",
      "backup",
      "interrupted_recovery",
      "rollback"
    ]
  },
  "hosts": [
    {
      "id": "claude_code",
      "edit": {
        "state": "evidenced",
        "event": "PostToolUse/Write",
        "capture": "crates/tracedecay-hooks/fixtures/host_events/claude/post_tool_use_write.json",
        "provenance": "crates/tracedecay-hooks/fixtures/host_events/claude/provenance.json"
      },
      "stop": {
        "state": "evidenced",
        "event": "Stop",
        "capture": "crates/tracedecay-hooks/fixtures/host_events/claude/stop.json",
        "provenance": "crates/tracedecay-hooks/fixtures/host_events/claude/provenance.json"
      }
    },
    {
      "id": "codex",
      "edit": {
        "state": "unavailable",
        "reason": "no_native_apply_patch_post_tool_use_callback_observed_capability_pending_adjudication"
