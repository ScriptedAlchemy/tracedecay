{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tracedecay.dev/schemas/pr10-locked-semantic-search-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload_id",
    "schema",
    "authority",
    "corpus",
    "production_apis",
    "model_integrity",
    "asynchronous_activation",
    "implementation_audit",
    "callable_acceptance",
    "profiles",
    "quality_metrics",
    "ablations",
    "calibration",
    "fallback",
    "resource_strata",
    "resource_metrics",
    "rollback",
    "parent_gates",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workload_id": {
      "const": "pr10-locked-semantic-search-v1"
    },
    "schema": {
      "const": "benchmarks/pr10-semantic-search/schema-v1.json"
    },
    "authority": {
      "const": "plan15_locked_evaluation_pending"
    },
    "corpus": {
      "type": "object"
    },
    "production_apis": {
      "type": "object",
      "required": [
        "fastembed_runtime",
        "vector_service"
      ]
    },
    "model_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_contract",
        "runtime_input",
        "fastembed_constructor",
        "fastembed_upstream_default_features",
        "ambient_hub_discovery",
        "ambient_cache_discovery",
        "query_time_download",
        "network_inference",
        "external_inference_process"
      ]
    },
    "asynchronous_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_execution",
        "baseline_lanes",
        "baseline_waits_for_semantic",
        "semantic_visibility",
        "excluded_generation_states",
        "excluded_states_affect_rank",
        "strict_semantic_behavior",
        "search_during_indexing_comparison",
        "activation_visibility"
      ]
    },
    "implementation_audit": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true
    },
    "callable_acceptance": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "minItems": 7
    },
    "quality_metrics": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true
    },
    "ablations": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true
    },
    "calibration": {
      "type": "object"
    },
    "fallback": {
      "type": "object"
    },
    "resource_strata": {
      "type": "array",
      "minItems": 2
    },
    "resource_metrics": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true
    },
    "rollback": {
      "type": "object"
    },
    "parent_gates": {
      "type": "array",
      "minItems": 14
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "required_outcome",
        "promotion_allowed",
        "semantic_activation_allowed",
        "terminal_non_accepting_outcomes"
      ],
      "properties": {
        "state": {
          "const": "pending_parent_gates"
        },
        "required_outcome": {
          "const": "accepted"
        },
        "promotion_allowed": {
          "const": false
        },
        "semantic_activation_allowed": {
          "const": false
        },
        "terminal_non_accepting_outcomes": {
          "type": "array",
          "contains": {
            "const": "runtime_fallback_observed"
          }
        }
      }
    }
  }
}
