+// INTERROGATE REPRO, not for merge. Runs the differential edits with the cold
+// fallback disabled, which is what the design's re-decide-through-dependency-
+// indexes claim needs to hold, and counts answers that differ from a cold build.
+fn repro_one(
+    tree: &[(String, String)],
+    previous: Option<usize>,
+    edited_tree: &[(String, String)],
+    index: usize,
+    out: &mut (usize, usize, usize, Vec<String>, usize),
+) {
+    use super::sparse_increment::REPRO_FORCE_SPARSE;
+    use std::sync::atomic::Ordering;
+    let store = WorkerPublicationStore::default();
+    let mut owner =
+        CodeIndexProductionOwnerV1::new(worker_config(), store.clone()).expect("owner");
+    REPRO_FORCE_SPARSE.store(false, Ordering::SeqCst);
+    publish(&mut owner, tree, previous, false, 1_100_000);
+    // Which edits does today's code refuse?
+    let probe_store = WorkerPublicationStore::default();
+    let mut probe =
+        CodeIndexProductionOwnerV1::new(worker_config(), probe_store.clone()).expect("probe");
+    publish(&mut probe, tree, previous, false, 1_100_000);
+    let unforced = publish(&mut probe, edited_tree, Some(index), true, 1_200_000);
+    let reason = unforced.cold_reason();
+    let refused = matches!(
+        reason,
+        Some(
+            CodeIndexColdBuildReasonV1::MovesNameLookups
+                | CodeIndexColdBuildReasonV1::MovesGoMethodSets
+        )
+    );
+    if !refused {
+        return;
+    }
+    REPRO_FORCE_SPARSE.store(true, Ordering::SeqCst);
+    let forced = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        publish(&mut owner, edited_tree, Some(index), true, 1_200_000)
+    }));
+    REPRO_FORCE_SPARSE.store(false, Ordering::SeqCst);
+    let cold_store = WorkerPublicationStore::default();
+    let cold = publish(
+        &mut CodeIndexProductionOwnerV1::new(worker_config(), cold_store.clone()).expect("cold"),
+        edited_tree,
+        Some(index),
+        false,
+        1_200_000,
+    );
+    super::helpers::take_seal_reference_resolutions();
+    out.0 += 1;
+    match forced {
+        Err(_) => {
+            out.2 += 1;
+            if out.3.len() < 4 {
+                out.3.push(format!("{}: forced sparse build errored", edited_tree[index].0));
+            }
+        }
+        Ok(forced) => {
+            let got = restored_answers(&store, &forced);
+            let want = restored_answers(&cold_store, &cold);
+            if got != want {
+                out.1 += 1;
+                if out.3.len() < 3 {
+                    use std::collections::BTreeSet;
+                    let name = |list: &[(String, String)]| list.to_vec();
+                    let _ = name;
+                    let g: BTreeSet<String> = got.0.iter().map(|e| format!("{e:?}")).collect();
+                    let w: BTreeSet<String> = want.0.iter().map(|e| format!("{e:?}")).collect();
+                    let missing: Vec<&String> = w.difference(&g).collect();
+                    let extra: Vec<&String> = g.difference(&w).collect();
+                    let gu: BTreeSet<String> = got.1.iter().map(|e| format!("{e:?}")).collect();
+                    let wu: BTreeSet<String> = want.1.iter().map(|e| format!("{e:?}")).collect();
+                    let mu = wu.difference(&gu).count();
+                    let eu = gu.difference(&wu).count();
+                    out.3.push(format!(
+                        "{} ({:?}): edges forced={} cold={} missing_from_forced={} extra_in_forced={} order_only={} unresolved_missing={} unresolved_extra={}\n  first missing: {:?}\n  first extra: {:?}",
+                        edited_tree[index].0,
+                        reason.map(|r| r.as_str()),
+                        got.0.len(),
+                        want.0.len(),
+                        missing.len(),
+                        extra.len(),
+                        missing.is_empty() && extra.is_empty() && mu == 0 && eu == 0,
+                        mu,
+                        eu,
+                        missing.first(),
+                        extra.first()
+                    ));
+                }
+                let g: std::collections::BTreeSet<String> = got.0.iter().map(|e| format!("{:?}", e.kind)).collect();
+                let _ = g;
+                let gs: std::collections::BTreeSet<String> = got.0.iter().map(|e| format!("{e:?}")).collect();
+                let ws: std::collections::BTreeSet<String> = want.0.iter().map(|e| format!("{e:?}")).collect();
+                let gu: std::collections::BTreeSet<String> = got.1.iter().map(|e| format!("{e:?}")).collect();
+                let wu: std::collections::BTreeSet<String> = want.1.iter().map(|e| format!("{e:?}")).collect();
+                if gs != ws || gu != wu { out.4 += 1; }
+            }
+        }
+    }
+}
