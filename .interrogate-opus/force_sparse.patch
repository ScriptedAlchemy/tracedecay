+#[test]
+fn repro_force_sparse_real_commit_shapes() {
+    // Go: a type gains a method. Satisfaction edge, no reference site.
+    let wrong =
+        "package calc\n\ntype Wrong struct{}\n\nfunc (Wrong) Add(a, b int) int { return a + b }\n";
+    repro_scenario("go method set", &go_tree(GO_WRONG, GO_UTIL), &go_tree(wrong, GO_UTIL));
+
+    // TypeScript: a barrel re-export is pointed at another file. main.ts is unchanged.
+    let ts = |barrel: &'static str| {
+        let mut tree = vec![
+            ("x/a.ts", "typescript", "export function helper() { return 1; }\n"),
+            ("x/b.ts", "typescript", "export function helper() { return 2; }\n"),
+            ("x/index.ts", "typescript", barrel),
+            ("x/main.ts", "typescript", "import { helper } from './index';\nexport function run() { return helper(); }\n"),
+        ];
+        tree.extend_from_slice(&P);
+        tree
+    };
+    repro_scenario(
+        "typescript barrel re-export moved",
+        &ts("export { helper } from './a';\n"),
+        &ts("export { helper } from './b';\n"),
+    );
+
+    // TypeScript: the importer itself gains a new import, callee binding changes.
+    let ts2 = |main: &'static str| {
+        let mut tree = vec![
+            ("x/a.ts", "typescript", "export function helper() { return 1; }\n"),
+            ("x/b.ts", "typescript", "export function helper() { return 2; }\n"),
+            ("x/main.ts", "typescript", main),
+            ("x/other.ts", "typescript", "import { helper } from './a';\nexport const o = helper();\n"),
+        ];
+        tree.extend_from_slice(&P);
+        tree
+    };
+    repro_scenario(
+        "typescript importer switches module",
+        &ts2("import { helper } from './a';\nexport function run() { return helper(); }\n"),
+        &ts2("import { helper } from './b';\nexport function run() { return helper(); }\n"),
+    );
+
+    // Python: package __init__ re-export moved. b.py is unchanged.
+    let py = |init: &'static str| {
+        vec![
+            ("pkg/__init__.py", "python", init),
+            ("pkg/one.py", "python", "def helper():\n    return 1\n"),
+            ("pkg/two.py", "python", "def helper():\n    return 2\n"),
+            ("pkg/b.py", "python", "from pkg import helper\n\ndef run():\n    return helper()\n"),
+            ("pkg/c.py", "python", "C = 1\n"),
+            ("pkg/d.py", "python", "D = 1\n"),
+            ("pkg/e.py", "python", "E = 1\n"),
+            ("pkg/f.py", "python", "F = 1\n"),
+            ("pkg/g.py", "python", "G = 1\n"),
+        ]
+    };
+    repro_scenario(
+        "python __init__ re-export moved",
+        &py("from pkg.one import helper\n"),
+        &py("from pkg.two import helper\n"),
+    );
+
+    // Rust: pub use re-export moved. main.rs is unchanged.
+    let rs = |lib: &'static str| {
+        vec![
+            ("src/lib.rs", RUST, lib),
+            ("src/one.rs", RUST, "pub fn helper() -> u32 { 1 }\n"),
+            ("src/two.rs", RUST, "pub fn helper() -> u32 { 2 }\n"),
+            ("src/main.rs", RUST, "pub fn run() -> u32 { crate::helper() }\n"),
+            ("src/a.rs", RUST, "pub fn a() {}\n"),
+            ("src/b.rs", RUST, "pub fn b() {}\n"),
+            ("src/c.rs", RUST, "pub fn c() {}\n"),
+            ("src/d.rs", RUST, "pub fn d() {}\n"),
+            ("src/e.rs", RUST, "pub fn e() {}\n"),
+        ]
+    };
+    repro_scenario(
+        "rust pub use re-export moved",
+        &rs("pub mod one;\npub mod two;\npub mod main;\npub use one::helper;\n"),
+        &rs("pub mod one;\npub mod two;\npub mod main;\npub use two::helper;\n"),
+    );
+
+    // Go: go.mod module path changes. Manifest edit; importers are unchanged.
+    let gm = |module: &'static str, imp: &'static str| {
+        vec![
+            ("go.mod", "go", module),
+            ("util/util.go", "go", "package util\n\nfunc Help() int { return 1 }\n"),
+            ("cmd/main.go", "go", imp),
+            ("a/a.go", "go", "package a\n\nfunc A() {}\n"),
+            ("b/b.go", "go", "package b\n\nfunc B() {}\n"),
+            ("c/c.go", "go", "package c\n\nfunc C() {}\n"),
+            ("d/d.go", "go", "package d\n\nfunc D() {}\n"),
+            ("e/e.go", "go", "package e\n\nfunc E() {}\n"),
+            ("f/f.go", "go", "package f\n\nfunc F() {}\n"),
+        ]
+    };
+    let main = "package main\n\nimport \"example.com/m/util\"\n\nfunc main() { util.Help() }\n";
+    repro_scenario(
+        "go.mod module path changed",
+        &gm("module example.com/m\n", main),
+        &gm("module example.com/renamed\n", main),
