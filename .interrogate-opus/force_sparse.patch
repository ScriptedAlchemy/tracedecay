+#[test]
+fn repro_force_sparse_all_languages() {
+    std::panic::set_hook(Box::new(|_| {}));
+    for language in ["rust", "typescript", "python", "go", "java", "ruby"] {
+        let tree = fixture_files(&Path::new(FIXTURE_ROOT).join(language));
+        let store = WorkerPublicationStore::default();
+        let mut owner = CodeIndexProductionOwnerV1::new(worker_config(), store.clone())
+            .expect("production owner");
+        let base = publish(&mut owner, &tree, None, false, 1_000_000);
+        let base = store
+            .decode_active(&CodeIndexGenerationScopeV1::for_snapshot(base.snapshot()))
+            .expect("decode")
+            .expect("active");
+        let mut out = (0usize, 0usize, 0usize, Vec::new(), 0usize);
+        for index in 0..tree.len() {
+            let (path, source) = &tree[index];
+            if matches!(language_for(path), "toml" | "json") || path.ends_with("go.mod") {
+                continue;
+            }
+            let mut shifted = tree.clone();
+            shifted[index].1 = format!("\n\n{source}");
+            repro_one(&tree, None, &shifted, index, &mut out);
+            let file = base
+                .files
+                .iter()
+                .find(|file| &file.authority.logical_path == path)
+                .expect("fixture file sealed");
+            let mut names = file
+                .artifacts
+                .symbols
+                .iter()
+                .map(|symbol| symbol.simple_name.clone())
+                .filter(|name| name.chars().all(|c| c.is_alphanumeric() || c == '_'))
+                .collect::<Vec<_>>();
+            names.sort();
+            names.dedup();
+            for name in names {
+                let mut renamed = tree.clone();
+                renamed[index].1 = rename_identifier(source, &name, &format!("{name}Renamed"));
+                repro_one(&tree, None, &renamed, index, &mut out);
+                repro_one(&renamed, Some(index), &tree, index, &mut out);
+            }
+        }
+        println!(
+            "REPRO {language}: refused_edits={} forced_answers_differ={} of_which_set_differs={} forced_errored={}",
+            out.0, out.1, out.4, out.2
+        );
+        for example in &out.3 {
+            println!("REPRO   {example}");
+        }
+        println!(
+            "REPRO {language} done{}",
+            ""
+        );
+    }
+}
