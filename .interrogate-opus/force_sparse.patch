+// INTERROGATE REPRO, not for merge. Edits real commits make, with the cold
+// fallback disabled, against a cold build of the same tree.
+fn repro_scenario(label: &str, before: &[(&str, &str, &str)], after: &[(&str, &str, &str)]) {
+    use super::sparse_increment::REPRO_FORCE_SPARSE;
+    let store = MemorySealedPublicationStoreV1::default();
+    let mut incremental = owner(&store);
+    REPRO_FORCE_SPARSE.store(false, Ordering::SeqCst);
+    publish(&mut incremental, before, 1_100_000);
+
+    let today_store = MemorySealedPublicationStoreV1::default();
+    let mut today = owner(&today_store);
+    publish(&mut today, before, 1_100_000);
+    let today_build = publish(&mut today, after, 1_200_000);
+
+    REPRO_FORCE_SPARSE.store(true, Ordering::SeqCst);
+    let forced = publish(&mut incremental, after, 1_200_000);
+    REPRO_FORCE_SPARSE.store(false, Ordering::SeqCst);
+    let cold_store = MemorySealedPublicationStoreV1::default();
+    publish(&mut owner(&cold_store), after, 1_200_000);
+    let (got, want) = (answers(&store), answers(&cold_store));
+    let named = |list: &[CanonicalRelationEdgeV1], g: &RestoredAnswersV1| {
+        let _ = g;
+        list.iter()
+            .map(|e| format!("{:?}", (e.kind, e.from_occurrence.as_str(), e.to_occurrence.as_str())))
+            .collect::<std::collections::BTreeSet<_>>()
+    };
+    let (ge, we) = (named(&got.edges, &got), named(&want.edges, &want));
+    let (gu, wu) = (
+        got.unresolved_calls.iter().map(|u| format!("{u:?}")).collect::<std::collections::BTreeSet<_>>(),
+        want.unresolved_calls.iter().map(|u| format!("{u:?}")).collect::<std::collections::BTreeSet<_>>(),
+    );
+    println!(
+        "REPRO2 {label}: today cold_reason={:?} forced cold_reason={:?} edges forced={} cold={} missing={} extra={} unresolved missing={} extra={} verdict={}",
+        today_build.cold_reason().map(|r| r.as_str()),
+        forced.cold_reason().map(|r| r.as_str()),
+        got.edges.len(),
+        want.edges.len(),
+        we.difference(&ge).count(),
+        ge.difference(&we).count(),
+        wu.difference(&gu).count(),
+        gu.difference(&wu).count(),
+        if ge == we && gu == wu { "same" } else { "WRONG" },
+    );
+}
