{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tracedecay.dev/schemas/tests/dashboard-codegen.json",
  "title": "DashboardCodegenTestFixture",
  "schemaRevision": 1,
  "description": "Synthetic fixture for focused TypeScript generator unit tests. Production generation never reads this file; dashboard/codegen/src/cli.ts exports fresh Serialize-contract JSON Schema from Rust.",
  "$defs": {
    "Authorization": {
      "type": "object",
      "description": "Authorization outcome (internally tagged on `outcome`). Only `authorized` is emitted by the local loopback dashboard today.",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["authorized", "unauthorized", "denied", "redacted"]
        }
      },
      "required": ["outcome"]
    },
    "Coverage": {
      "type": "object",
      "description": "Coverage statement. `completeness` is authoritative; an unknown denominator is null, never a fabricated 0/100%.",
      "properties": {
        "completeness": {
          "type": "string",
          "enum": ["complete", "partial", "unknown", "unsupported"]
        },
        "eligible": { "type": ["integer", "null"] },
        "examined": { "type": ["integer", "null"] },
        "matched": { "type": ["integer", "null"] },
        "excluded": { "type": ["integer", "null"] },
        "omitted": { "type": ["integer", "null"] },
        "unknown": { "type": ["integer", "null"] },
        "denominator": { "type": ["integer", "null"] },
        "unit": { "type": ["string", "null"] },
        "omission_reasons": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "completeness",
        "eligible",
        "examined",
        "matched",
        "excluded",
        "omitted",
        "unknown",
        "denominator",
        "unit",
        "omission_reasons"
      ]
    },
    "DashboardDomainState": {
      "description": "The closed 17-value domain-state union (snake_case). `unsupported` (live producer not yet wired server-side) is canonically emitted by the server and is distinct from `unsupported_schema` (an undecodable schema/variant).",
      "type": "string",
      "enum": [
        "loading",
        "complete_zero_findings",
        "ready",
        "partial",
        "stale",
        "locked",
        "denied",
        "unauthorized",
        "redacted",
        "conflicting",
        "offline",
        "unknown",
        "cancelled",
        "timed_out",
        "error",
        "unsupported_schema",
        "unsupported"
      ]
    },
    "Freshness": {
      "type": "object",
      "description": "Freshness statement. `absent` (no source produced anything) and `unsupported` (no source wired) are distinct from `stale` and `unknown`.",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["fresh", "stale", "unknown", "absent", "unsupported"]
        },
        "observed_at_micros": { "type": ["integer", "null"] },
        "watermark": { "type": ["string", "null"] }
      },
      "required": ["state", "observed_at_micros", "watermark"]
    },
    "LegalActionKind": {
      "type": "string",
      "enum": [
        "inspect",
        "expand_evidence",
        "refresh",
        "request_dry_run",
        "request_apply",
        "request_cancel"
      ]
    },
    "LegalActionRef": {
      "type": "object",
      "description": "Reference to one owner-supplied legal action. No command payload; `operation` names the owning application operation.",
      "properties": {
        "kind": { "$ref": "#/$defs/LegalActionKind" },
        "operation": { "type": "string" }
      },
      "required": ["kind", "operation"]
    },
    "Scope": {
      "type": "object",
      "description": "Exact resolved scope. Never falls back to a title, path, or latest version.",
      "properties": {
        "project_id": { "type": ["string", "null"] },
        "storage_mode": { "type": "string" },
        "store_root": { "type": "string" }
      },
      "required": ["project_id", "storage_mode", "store_root"]
    },
    "Time": {
      "type": "object",
      "description": "Valid time and observation time, kept separate. Microseconds since the Unix epoch.",
      "properties": {
        "valid_time_micros": { "type": ["integer", "null"] },
        "observation_time_micros": { "type": "integer" }
      },
      "required": ["valid_time_micros", "observation_time_micros"]
    },
    "Version": {
      "type": "object",
      "description": "Entity/graph version identity. Both optional; absent rather than invented 0/latest.",
      "properties": {
        "entity_version": { "type": ["string", "null"] },
        "graph_version": { "type": ["string", "null"] }
      },
      "required": ["entity_version", "graph_version"]
    },
    "Watermark": {
      "type": "object",
      "description": "Opaque monotone source watermark. Compared for staleness, never parsed.",
      "properties": {
        "source": { "type": "string" },
        "watermark": { "type": "string" }
      },
      "required": ["source", "watermark"]
    },
    "FindingPayload": {
      "type": "object",
      "description": "Representative domain payload (the `T` in DashboardEnvelope<T>). Severity and evidence quality are separate token axes, never one scale.",
      "properties": {
        "finding_id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "evidence_quality": {
          "type": "string",
          "enum": ["unverified", "weak", "corroborated", "verified"]
        }
      },
      "required": ["finding_id", "title", "summary", "severity", "evidence_quality"]
    },
    "DashboardEnvelope": {
      "type": "object",
      "x-generic": "TPayload",
      "description": "DashboardEnvelopeV1<TPayload>. Every V2 read-model route returns exactly this shape; only `payload` varies. Carries schema revision, exact scope, entity/graph version, valid+observation time, optional source watermark, authorization, coverage, freshness, domain state, legal action references, and payload.",
      "properties": {
        "schema_revision": { "type": "integer" },
        "scope": { "$ref": "#/$defs/Scope" },
        "version": { "$ref": "#/$defs/Version" },
        "time": { "$ref": "#/$defs/Time" },
        "source_watermark": {
          "anyOf": [{ "$ref": "#/$defs/Watermark" }, { "type": "null" }]
        },
        "authorization": { "$ref": "#/$defs/Authorization" },
        "coverage": { "$ref": "#/$defs/Coverage" },
        "freshness": { "$ref": "#/$defs/Freshness" },
        "domain_state": { "$ref": "#/$defs/DashboardDomainState" },
        "legal_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/LegalActionRef" }
        },
        "payload": { "x-generic-ref": "TPayload" }
      },
      "required": [
        "schema_revision",
        "scope",
        "version",
        "time",
        "source_watermark",
        "authorization",
        "coverage",
        "freshness",
        "domain_state",
        "legal_actions",
        "payload"
      ]
    }
  }
}
